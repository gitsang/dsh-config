ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1

llm-pi-ai:
  providers:
    saigw:
      displayName: SaiGW
      apiKeyEnv: SAIGW_API_KEY
      api: openai-completions
      baseURL: https://aigw.cn.c8g.top/v1
      models:
        - id: auto
          name: Auto
          contextWindow: 1000000
          maxTokens: 384000
          input: [ text ]
          reasoningEfforts:
            low: low
            high: high
            max: max
          compat:
            thinkingFormat: deepseek
        - id: deepseek-flash
          name: DeepSeek V4 Flash
          contextWindow: 1000000
          maxTokens: 384000
          input: [ text ]
          reasoningEfforts:
            low: low
            high: high
            max: max
          compat:
            thinkingFormat: deepseek

    saigw-openai:
      displayName: SaiGW (Responses)
      apiKeyEnv: SAIGW_API_KEY
      api: openai-responses
      baseURL: https://aigw.cn.c8g.top/v1
      models:
        - id: gpt-6.1-sol
          name: GPT 6.1 Sol
          contextWindow: 400000
          maxTokens: 128000
          input: [ text, image ]
          reasoningEfforts:
            low: low
            medium: medium
            high: high
            xhigh: xhigh

    saigw-anthropic:
      displayName: SaiGW (Anthropic)
      apiKeyEnv: SAIGW_API_KEY
      api: anthropic-messages
      baseURL: https://aigw.cn.c8g.top/anthropic/v1
      models:
        - id: claude-opus
          name: Claude Opus
          contextWindow: 1048576
          maxTokens: 131072
          input: [ text, image ]
          reasoningEfforts:
            minimal: low
            low: low
            medium: medium
            high: high

agent-default-model:
  provider: saigw
  model: auto
agent-presets:
  default: minimal
ui-theme:
  preference: light
dsh-better-sidebar:
  titleBarScheme: web
  titleBarCompat: false
